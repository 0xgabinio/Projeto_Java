<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%-- Fragmento comum (specs/estilizar-interface.md): incluído via <%@ include %> no topo de
     cada JSP de página. Cada página define "pageTitle" (c:set) antes de incluir este arquivo.
     integrity/crossorigin (SRI) calculados a partir do arquivo real do CDN — não copiados de
     memória (ver Considerações de Segurança da spec).
     pageEncoding acima é necessário mesmo com o <%@ page contentType=...UTF-8 %> da página
     principal — Jasper não garante herdar a codificação de leitura do arquivo incluído a
     partir da página que o inclui (bug real encontrado testando no Tomcat). --%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> — Catálogo Simples de Filmes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous">
    <link href="${pageContext.request.contextPath}/css/estilo.css" rel="stylesheet">
    <%-- Aplica o tema salvo (ou a preferência do sistema) ANTES da página desenhar, de forma
         síncrona — evita o "flash" de tema errado ao navegar. A troca via botão fica em
         js/tema.js (precisa do DOM pronto), carregado no footer.jspf. --%>
    <script>
        (function () {
            var temaSalvo = null;
            try {
                temaSalvo = localStorage.getItem("catalogoTema");
            } catch (erroArmazenamento) {
                // Segue sem tema salvo (ex.: modo privado restrito).
            }
            var preferido = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark" : "light";
            document.documentElement.setAttribute("data-bs-theme", temaSalvo || preferido);
        })();
    </script>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="${pageContext.request.contextPath}/listarFilmes">🎬 Catálogo de Filmes</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarConteudo" aria-controls="navbarConteudo"
                aria-expanded="false" aria-label="Abrir menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarConteudo">
            <div class="navbar-nav me-auto">
                <a class="nav-link" href="${pageContext.request.contextPath}/listarFilmes">Catálogo</a>
                <a class="nav-link" href="${pageContext.request.contextPath}/cadastrarFilme">Cadastrar</a>
                <a class="nav-link" href="${pageContext.request.contextPath}/descobrirFilmes">Descobrir (TMDB)</a>
            </div>
            <button id="alternarTema" type="button" class="btn btn-outline-light btn-sm"
                    aria-label="Alternar modo escuro">🌙</button>
        </div>
    </div>
</nav>
<main class="container pb-5">
