# Template de configuração de banco de dados.
#
# Copie este arquivo para "db.properties" (no mesmo diretório) e preencha com suas
# credenciais locais. "db.properties" nunca é versionado (ver .gitignore) — nunca commitar
# credenciais reais aqui ou em qualquer outro arquivo rastreado pelo git.

db.url=jdbc:mysql://localhost:3306/catalogo?useSSL=false&serverTimezone=UTC
db.usuario=SEU_USUARIO_AQUI
db.senha=SUA_SENHA_AQUI
