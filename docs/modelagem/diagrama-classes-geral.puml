@startuml diagrama-classes-geral
' Diagrama de classes consolidado do Catálogo Simples de Filmes.
' Acumulado incrementalmente pela skill modelar-uml a cada spec modelada.
' Origem desta versão: specs/cadastrar-filme.md, specs/listar-filmes.md, specs/detalhar-filme.md,
' specs/editar-filme.md, specs/excluir-filme.md, specs/buscar-filme.md,
' specs/integrar-tmdb.md, specs/estilizar-interface.md.

class Filme {
  -id: int
  -titulo: String
  -diretor: String
  -anoLancamento: int
  -genero: String
  -sinopse: String
  -capaUrl: String
  -notaTmdb: Double
  +getId(): int
  +getTitulo(): String
  +setTitulo(titulo: String): void
  +getDiretor(): String
  +setDiretor(diretor: String): void
  +getAnoLancamento(): int
  +setAnoLancamento(anoLancamento: int): void
  +getGenero(): String
  +setGenero(genero: String): void
  +getSinopse(): String
  +setSinopse(sinopse: String): void
  +getCapaUrl(): String
  +setCapaUrl(capaUrl: String): void
  +getNotaTmdb(): Double
  +setNotaTmdb(notaTmdb: Double): void
}

interface FilmeDAO {
  +inserir(filme: Filme): void
  +listarTodos(): List<Filme>
  +buscarPorId(id: int): Filme
  +atualizar(filme: Filme): void
  +excluir(id: int): void
  +buscarPorTituloOuDiretor(termo: String): List<Filme>
  +existeComTituloEAno(titulo: String, anoLancamento: int): boolean
}

class FilmeDAOImpl {
  -conexao: Connection
  +inserir(filme: Filme): void
  +listarTodos(): List<Filme>
  +buscarPorId(id: int): Filme
  +atualizar(filme: Filme): void
  +excluir(id: int): void
  +buscarPorTituloOuDiretor(termo: String): List<Filme>
  +existeComTituloEAno(titulo: String, anoLancamento: int): boolean
}

class FabricaDeConexoes {
  +{static} getConexao(): Connection
}

class TmdbFilme {
  +tmdbId: int
  +titulo: String
  +anoLancamento: int
  +diretor: String
  +genero: String
  +sinopse: String
  +capaUrl: String
  +notaTmdb: double
}

class FabricaTmdb {
  +{static} isConfigurado(): boolean
  +{static} getApiKey(): String
  +{static} getBaseUrl(): String
  +{static} getImageBaseUrl(): String
}

class TmdbException {
}
note right of TmdbException
  Exceção verificada única da camada
  com.catalogo.tmdb (rede, timeout, HTTP
  de erro, JSON malformado) — Servlets
  capturam só este tipo, nunca expõem a
  causa técnica ao usuário final.
end note

class TmdbClient {
  +buscarPorTitulo(termo: String): List<TmdbFilme>
  +buscarDetalhes(tmdbId: int): TmdbFilme
  +listarPopulares(): List<TmdbFilme>
}

class DescobrirFilmesServlet {
  +doGet(req, resp): void
}

class ImportarFilmeTmdbServlet {
  +doPost(req, resp): void
}

class CadastrarFilmeServlet {
  +doGet(req, resp): void
  +doPost(req, resp): void
}

class ListarFilmesServlet {
  +doGet(req, resp): void
}

class DetalharFilmeServlet {
  +doGet(req, resp): void
}

class EditarFilmeServlet {
  +doGet(req, resp): void
  +doPost(req, resp): void
}

class ExcluirFilmeServlet {
  +doPost(req, resp): void
}

class FilmeValidator {
  +{static} validar(titulo, diretor, anoLancamentoStr, genero): List<String>
  +{static} tratarEntrada(valor: String): String
}

class CodificacaoUtf8Filter {
  +doFilter(req, resp, chain): void
}
note right of CodificacaoUtf8Filter
  @WebFilter("/*") — primeiro na cadeia,
  força UTF-8 em toda requisição/resposta
  (encontrado testando a aplicação real
  no Tomcat; Servlet API decodifica
  parâmetros como ISO-8859-1 por padrão).
end note

class CabecalhosSegurancaFilter {
  +doFilter(req, resp, chain): void
}
note right of CabecalhosSegurancaFilter
  @WebFilter("/*") — adiciona X-Frame-Options,
  X-Content-Type-Options, Content-Security-Policy
  e Referrer-Policy a toda resposta HTTP
  (achado headers-seguranca-ausentes do
  pentest blackbox, A05:2021, corrigido).
end note

FilmeDAOImpl ..|> FilmeDAO
FilmeDAOImpl --> FabricaDeConexoes : usa
CadastrarFilmeServlet --> FilmeDAO : usa
CadastrarFilmeServlet --> FilmeValidator : usa
ListarFilmesServlet --> FilmeDAO : usa
DetalharFilmeServlet --> FilmeDAO : usa
EditarFilmeServlet --> FilmeDAO : usa
EditarFilmeServlet --> FilmeValidator : usa
ExcluirFilmeServlet --> FilmeDAO : usa
FilmeDAOImpl --> Filme : persiste/retorna/atualiza/exclui
TmdbClient --> FabricaTmdb : usa
TmdbClient --> TmdbFilme : retorna
TmdbClient ..> TmdbException : lança
DescobrirFilmesServlet --> TmdbClient : usa
ImportarFilmeTmdbServlet --> TmdbClient : usa
ImportarFilmeTmdbServlet --> FilmeDAO : usa (inserir)
ImportarFilmeTmdbServlet --> FilmeValidator : usa
CadastrarFilmeServlet --> TmdbClient : usa (busca opcional)

@enduml
