@startuml diagrama-classes-geral
' Diagrama de classes consolidado do Catálogo Simples de Filmes.
' Acumulado incrementalmente pela skill modelar-uml a cada spec modelada.
' Origem desta versão: specs/cadastrar-filme.md, specs/listar-filmes.md, specs/detalhar-filme.md,
' specs/editar-filme.md, specs/excluir-filme.md, specs/buscar-filme.md.

class Filme {
  -id: int
  -titulo: String
  -diretor: String
  -anoLancamento: int
  -genero: String
  -sinopse: String
  +getId(): int
  +getTitulo(): String
  +setTitulo(titulo: String): void
  +getDiretor(): String
  +setDiretor(diretor: String): void
  +getAnoLancamento(): int
  +setAnoLancamento(anoLancamento: int): void
  +getGenero(): String
  +setGenero(genero: String): void
  +getSinopse(): String
  +setSinopse(sinopse: String): void
}

interface FilmeDAO {
  +inserir(filme: Filme): void
  +listarTodos(): List<Filme>
  +buscarPorId(id: int): Filme
  +atualizar(filme: Filme): void
  +excluir(id: int): void
  +buscarPorTituloOuDiretor(termo: String): List<Filme>
}

class FilmeDAOImpl {
  -conexao: Connection
  +inserir(filme: Filme): void
  +listarTodos(): List<Filme>
  +buscarPorId(id: int): Filme
  +atualizar(filme: Filme): void
  +excluir(id: int): void
  +buscarPorTituloOuDiretor(termo: String): List<Filme>
}

class CadastrarFilmeServlet {
  +doGet(req, resp): void
  +doPost(req, resp): void
}

class ListarFilmesServlet {
  +doGet(req, resp): void
}

class DetalharFilmeServlet {
  +doGet(req, resp): void
}

class EditarFilmeServlet {
  +doGet(req, resp): void
  +doPost(req, resp): void
}

class ExcluirFilmeServlet {
  +doPost(req, resp): void
}

class FilmeValidator {
  +{static} validar(titulo, diretor, anoLancamentoStr, genero): List<String>
  +{static} tratarEntrada(valor: String): String
}

FilmeDAOImpl ..|> FilmeDAO
CadastrarFilmeServlet --> FilmeDAO : usa
CadastrarFilmeServlet --> FilmeValidator : usa
ListarFilmesServlet --> FilmeDAO : usa
DetalharFilmeServlet --> FilmeDAO : usa
EditarFilmeServlet --> FilmeDAO : usa
EditarFilmeServlet --> FilmeValidator : usa
ExcluirFilmeServlet --> FilmeDAO : usa
FilmeDAOImpl --> Filme : persiste/retorna/atualiza/exclui

@enduml
